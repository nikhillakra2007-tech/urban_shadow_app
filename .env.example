# UUS Delhi (Urban Shadow) — backend environment template.
# Copy to `.env` / set in your host and fill with REAL values.
# Variable NAMES only — never put real secrets in this file.

# Comma-separated list of allowed browser origins for CORS.
# Local dev:  http://localhost:3000
# Production: https://your-frontend-host.example
ALLOWED_ORIGINS=http://localhost:3000

# Port the API binds to (Render injects this automatically).
PORT=8000
